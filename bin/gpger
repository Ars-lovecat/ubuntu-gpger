#!/usr/bin/python3
"""gpger: GPG 공개키를 받아 apt 소스에 자동 등록하는 도구."""

import argparse
import copy
import gzip
import json
import logging
import logging.handlers
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

try:
    import yaml
except ImportError:
    sys.exit("[gpger] PyYAML이 필요합니다: sudo apt install python3-yaml")

# stdout이 파이프/리다이렉트로 연결돼도 stderr(die 메시지)와 순서가 뒤섞이지 않도록 강제한다.
sys.stdout.reconfigure(line_buffering=True)


# 종료 코드 (0=성공, 1=미처리 예외는 파이썬 기본값)
EXIT_USAGE = 2
EXIT_CONFIG = 10
EXIT_PERMISSION = 20
EXIT_NETWORK = 30
EXIT_GPG = 40
EXIT_FILESYSTEM = 50
EXIT_APT_UPDATE = 60

DOWNLOAD_TIMEOUT = 15
DOWNLOAD_RETRIES = 3
MAX_DOWNLOAD_SIZE = 5 * 1024 * 1024  # GPG 키는 원래 아주 작음, 5MB면 충분한 상한


def die(code, message):
    print(f"[gpger] {message}", file=sys.stderr)
    sys.exit(code)


class AptUpdateFailed(Exception):
    def __init__(self, returncode):
        self.returncode = returncode
        super().__init__(f"apt-get update exited with {returncode}")


SCRIPT_PATH = os.path.realpath(__file__)
REPO_ROOT = os.path.dirname(os.path.dirname(SCRIPT_PATH))
DEFAULT_CONFIG_PATH = os.path.join(REPO_ROOT, "config", "config.default.yaml")


def resolve_home():
    # sudo로 실행되면 HOME이 /root로 바뀌므로, 원래 사용자의 홈을 SUDO_USER로 역추적한다.
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user and sudo_user != "root":
        try:
            return pwd.getpwnam(sudo_user).pw_dir
        except KeyError:
            pass
    return os.path.expanduser("~")


HOME = resolve_home()
CONFIG_DIR = os.path.join(HOME, ".config", "gpger")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.yaml")


def resolve_invoking_user_ids():
    # sudo로 실행 중일 때만 의미가 있다 — root가 만든 파일이 SUDO_USER 소유로
    # 남아있어야, 나중에 sudo 없이 실행할 때 권한 오류가 안 난다.
    sudo_user = os.environ.get("SUDO_USER")
    if not sudo_user or sudo_user == "root" or os.geteuid() != 0:
        return None
    try:
        pw = pwd.getpwnam(sudo_user)
        return pw.pw_uid, pw.pw_gid
    except KeyError:
        return None


def is_inside_home(path):
    real_path = os.path.realpath(path)
    real_home = os.path.realpath(HOME)
    return real_path == real_home or real_path.startswith(real_home + os.sep)


def quiet_chown(path, ids):
    if ids is None:
        return
    try:
        os.chown(path, *ids)
    except OSError:
        pass


def quiet_fchown(fileobj, ids):
    if ids is None:
        return
    try:
        os.fchown(fileobj.fileno(), *ids)
    except OSError:
        pass


def chown_dir_with_consent(path, description):
    # 홈 디렉터리 안쪽이면 조용히 처리한다 (원래 사용자 소유가 되는 게 항상 맞음).
    # 홈 밖의 경로(예: /var/log, 심볼릭 링크로 밖을 가리키는 경우 포함)라면
    # 시스템 디렉터리를 건드리는 것일 수 있으니 명시적으로 확인받는다.
    ids = resolve_invoking_user_ids()
    if ids is None:
        return
    if not is_inside_home(path):
        sudo_user = os.environ.get("SUDO_USER")
        real_path = os.path.realpath(path)
        print(f"[gpger] 경고: {description}({real_path})이 홈 디렉터리 밖에 있습니다.")
        print(f"[gpger] 이 디렉터리와 그 안의 로그 파일의 소유권을 {sudo_user}:{sudo_user}로 변경합니다.")
        if not confirm("[gpger] 계속하시겠습니까? [y/N] "):
            print(f"[gpger] {description} 소유권 변경을 건너뜁니다.")
            return
    quiet_chown(path, ids)


def expand_path(path):
    if path == "~":
        return HOME
    if path.startswith("~/"):
        return os.path.join(HOME, path[2:])
    return os.path.expandvars(path)


AUTO_YES = False


def confirm(prompt):
    if AUTO_YES:
        return True
    resp = input(prompt)
    return resp.strip().lower() == "y"


def ensure_dir(path, description):
    if os.path.isdir(path):
        return
    print(f"[gpger] {description}이(가) 없습니다: {path}")
    if not confirm("[gpger] 지금 만들까요? [y/N] "):
        die(EXIT_FILESYSTEM, f"{path}이(가) 없어 진행할 수 없습니다.")
    os.makedirs(path)
    print(f"[gpger] {path}을(를) 만들었습니다.")


def ensure_config_dir():
    ensure_dir(CONFIG_DIR, "설정 폴더")


def ensure_config_file():
    ensure_config_dir()
    if os.path.isfile(CONFIG_PATH):
        return
    print(f"[gpger] 설정 파일이 없습니다: {CONFIG_PATH}")
    if not confirm("[gpger] 기본 설정으로 새로 만들까요? [y/N] "):
        die(EXIT_CONFIG, "설정 파일이 없어 진행할 수 없습니다.")
    shutil.copy(DEFAULT_CONFIG_PATH, CONFIG_PATH)
    print(f"[gpger] 기본 설정을 생성했습니다: {CONFIG_PATH}")


def load_config_raw():
    # 문법/자료구조만 확인한다 (값의 의미는 검증하지 않음) — config get/set/ls가
    # 값이 깨진 상태에서도 조회하거나 set으로 고칠 수 있어야 하기 때문에 쓴다.
    ensure_config_file()
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as f:
            cfg = yaml.safe_load(f)
    except yaml.YAMLError as e:
        die(EXIT_CONFIG, f"설정 파일 문법이 잘못됐습니다: {CONFIG_PATH}\n{e}\n'gpger config reset'으로 초기화할 수 있습니다.")
    if not isinstance(cfg, dict):
        die(EXIT_CONFIG, f"설정 파일이 비어 있거나 형식이 잘못됐습니다: {CONFIG_PATH}\n'gpger config reset'으로 초기화할 수 있습니다.")
    return cfg


def load_config():
    # apt 등록처럼 실제로 값을 써서 동작하는 명령은 값 검증까지 통과해야 한다.
    cfg = load_config_raw()
    errors = validate_config(cfg)
    if errors:
        die(
            EXIT_CONFIG,
            "설정 파일 값이 유효하지 않습니다:\n"
            + "\n".join(f"  - {e}" for e in errors)
            + "\n'gpger config set <키> <값>'으로 고치거나 'gpger config reset'으로 초기화하세요.",
        )
    return cfg


def save_config(cfg):
    # 임시 파일에 먼저 쓰고 원자적으로 교체 — 쓰는 중간에 죽어도 기존 파일이 반쪼가리로 남지 않는다.
    tmp_path = CONFIG_PATH + ".tmp"
    with open(tmp_path, "w", encoding="utf-8") as f:
        yaml.safe_dump(cfg, f, allow_unicode=True, sort_keys=False)
    os.replace(tmp_path, CONFIG_PATH)


def flatten_config(d, prefix=""):
    items = []
    for k, v in d.items():
        key = f"{prefix}.{k}" if prefix else k
        if isinstance(v, dict):
            items.extend(flatten_config(v, key))
        else:
            items.append((key, v))
    return items


def format_value(value):
    if isinstance(value, list):
        return ", ".join(str(v) for v in value)
    if isinstance(value, str) and "\n" in value:
        return "\n" + "\n".join(f"  {line}" for line in value.splitlines())
    return str(value)


def get_nested(cfg, dotted_key):
    node = cfg
    for part in dotted_key.split("."):
        if not isinstance(node, dict) or part not in node:
            return None, False
        node = node[part]
    return node, True


def set_nested(cfg, dotted_key, raw_value):
    parts = dotted_key.split(".")
    node = cfg
    for part in parts[:-1]:
        if not isinstance(node, dict) or part not in node:
            die(EXIT_CONFIG, f"'{dotted_key}' 키를 찾을 수 없습니다.")
        node = node[part]
    last = parts[-1]
    if not isinstance(node, dict) or last not in node:
        die(EXIT_CONFIG, f"'{dotted_key}' 키를 찾을 수 없습니다.")
    if isinstance(node[last], (dict, list)):
        die(EXIT_CONFIG, f"'{dotted_key}'는 목록/구조체 값이라 set으로 바꿀 수 없습니다.")
    node[last] = yaml.safe_load(raw_value)


ALLOWED_CONFIG_KEYS = {
    "system.arch",
    "apt.args",
    "apt.paths.gpg_dir",
    "apt.paths.source_dir",
    "apt.source_template",
    "apt.file.permission",
    "logging.dir",
    "logging.max_size_mb",
    "logging.backup_count",
    "logging.compress",
}


def is_nonempty_str(v):
    return isinstance(v, str) and v.strip() != ""


def is_valid_int(v):
    # bool은 int의 서브클래스라 isinstance(True, int)가 True로 나오므로, type()으로 엄격히 구분한다.
    return type(v) is int


def validate_config(cfg):
    errors = []

    def check(dotted_key, ok, expectation):
        if not ok:
            value, found = get_nested(cfg, dotted_key)
            actual = value if found else "(없음)"
            errors.append(f"'{dotted_key}': {expectation} (실제 값: {actual!r})")

    for key, _ in flatten_config(cfg):
        if key not in ALLOWED_CONFIG_KEYS:
            errors.append(f"'{key}': 알 수 없는 설정 키입니다.")

    arch, _ = get_nested(cfg, "system.arch")
    check("system.arch", is_nonempty_str(arch), "비어있지 않은 문자열이어야 함")

    args, _ = get_nested(cfg, "apt.args")
    check(
        "apt.args",
        isinstance(args, list) and len(args) > 0 and all(is_nonempty_str(a) for a in args),
        "비어있지 않은 문자열 목록이어야 함",
    )

    for key in ("apt.paths.gpg_dir", "apt.paths.source_dir", "apt.source_template", "logging.dir"):
        value, _ = get_nested(cfg, key)
        check(key, is_nonempty_str(value), "비어있지 않은 문자열이어야 함")

    permission, _ = get_nested(cfg, "apt.file.permission")
    check(
        "apt.file.permission",
        isinstance(permission, str) and re.fullmatch(r"[0-7]{3,4}", permission) is not None,
        "3~4자리 8진수 문자열이어야 함 (예: '644')",
    )

    max_size, _ = get_nested(cfg, "logging.max_size_mb")
    check("logging.max_size_mb", is_valid_int(max_size) and max_size > 0, "0보다 큰 정수여야 함")

    backup_count, _ = get_nested(cfg, "logging.backup_count")
    check("logging.backup_count", is_valid_int(backup_count) and backup_count >= 0, "0 이상의 정수여야 함")

    compress, _ = get_nested(cfg, "logging.compress")
    check("logging.compress", type(compress) is bool, "true/false여야 함")

    return errors


class JsonFormatter(logging.Formatter):
    def format(self, record):
        payload = {
            "time": self.formatTime(record, "%Y-%m-%dT%H:%M:%S"),
            "level": record.levelname,
            "message": record.getMessage(),
        }
        if record.exc_info:
            payload["exc_info"] = self.formatException(record.exc_info)
        return json.dumps(payload, ensure_ascii=False)


class OwnershipFixingRotatingFileHandler(logging.handlers.RotatingFileHandler):
    # RotatingFileHandler.doRollover()는 회전 후 새 활성 로그 파일을 다시 여는데,
    # 이게 root로 실행 중이면 새로 열린 파일이 root 소유로 생성된다. _open()을
    # 오버라이드해서 매번(최초 생성이든 로테이션 후 재오픈이든) 열린 파일 디스크립터를
    # 바로 fchown한다 — 경로 기반 chown보다 TOCTOU에 안전하다.
    def _open(self):
        stream = super()._open()
        quiet_fchown(stream, resolve_invoking_user_ids())
        return stream


class GzipRotatingFileHandler(OwnershipFixingRotatingFileHandler):
    # namer가 .gz를 붙여야 doRollover()의 내부 rename 루프가 실제 파일명(.N.gz)을 찾아서
    # 밀어낼 수 있다. namer 없이 rotator에서만 .gz를 붙이면 로테이션마다 .1.gz를 계속
    # 덮어써서 backup_count가 무의미해진다.
    def namer(self, default_name):
        return default_name + ".gz"

    def rotator(self, source, dest):
        with open(source, "rb") as f_in, gzip.open(dest, "wb") as f_out:
            shutil.copyfileobj(f_in, f_out)
        os.remove(source)
        quiet_chown(dest, resolve_invoking_user_ids())


def setup_logging(cfg):
    log_cfg = cfg.get("logging", {})
    log_dir = expand_path(log_cfg.get("dir", "~/log"))
    ensure_dir(log_dir, "로그 폴더")
    chown_dir_with_consent(log_dir, "로그 폴더")
    log_path = os.path.join(log_dir, "gpger.log")

    max_bytes = int(log_cfg.get("max_size_mb", 100)) * 1024 * 1024
    backup_count = int(log_cfg.get("backup_count", 5))
    compress = bool(log_cfg.get("compress", True))

    # 압축 여부와 무관하게 OwnershipFixingRotatingFileHandler 계열을 써서, 최초 생성과
    # 로테이션 후 재오픈 둘 다 자동으로 소유권이 맞춰지게 한다.
    handler_cls = GzipRotatingFileHandler if compress else OwnershipFixingRotatingFileHandler
    handler = handler_cls(log_path, maxBytes=max_bytes, backupCount=backup_count)
    handler.setFormatter(JsonFormatter())

    logger = logging.getLogger("gpger")
    logger.setLevel(logging.INFO)
    logger.handlers.clear()
    logger.addHandler(handler)
    return logger


def detect_arch():
    return subprocess.run(
        ["dpkg", "--print-architecture"], capture_output=True, text=True, check=True
    ).stdout.strip()


def resolve_arch(cfg):
    arch = cfg.get("system", {}).get("arch", "auto")
    if arch == "auto":
        arch = detect_arch()
    return arch


def detect_codename():
    values = {}
    try:
        with open("/etc/os-release", encoding="utf-8") as f:
            for line in f:
                if "=" in line:
                    key, _, value = line.strip().partition("=")
                    values[key] = value.strip('"')
    except FileNotFoundError:
        return None
    # UBUNTU_CODENAME을 우선한다: 우분투 파생 배포판에서는 VERSION_CODENAME이
    # 배포판 자신의 코드네임일 수 있어, 실제 우분투 베이스와 다를 수 있다.
    return values.get("UBUNTU_CODENAME") or values.get("VERSION_CODENAME")


def resolve_auto_values(named_args):
    for key, value in named_args.items():
        if value != "auto":
            continue
        codename = detect_codename()
        if not codename:
            die(EXIT_CONFIG, f"{key} 값을 자동 감지하지 못했습니다 (/etc/os-release에 코드네임 정보 없음). 직접 입력해주세요.")
        named_args[key] = codename


def download(url):
    if not url.startswith("https://"):
        die(EXIT_NETWORK, "GPG 키 URL은 https://여야 합니다 (보안을 위해 http는 허용하지 않습니다).")

    req = urllib.request.Request(url, headers={"User-Agent": "gpger/1.0"})
    last_error = None
    for attempt in range(1, DOWNLOAD_RETRIES + 1):
        try:
            with urllib.request.urlopen(req, timeout=DOWNLOAD_TIMEOUT) as resp:
                # urllib은 https->http 리다이렉트도 그냥 따라가므로, 최종 URL의 스킴을 다시 확인한다.
                if not resp.geturl().startswith("https://"):
                    die(EXIT_NETWORK, f"리다이렉트된 최종 URL이 https://가 아닙니다: {resp.geturl()}")
                body = resp.read(MAX_DOWNLOAD_SIZE + 1)
                if len(body) > MAX_DOWNLOAD_SIZE:
                    die(EXIT_NETWORK, f"다운로드 크기가 {MAX_DOWNLOAD_SIZE // (1024 * 1024)}MB 상한을 초과합니다.")
                return body
        except urllib.error.HTTPError as e:
            if 400 <= e.code < 500:
                die(EXIT_NETWORK, f"{url} 다운로드 실패: HTTP {e.code} (재시도해도 소용없는 오류입니다)")
            last_error = e
        except (urllib.error.URLError, OSError) as e:
            last_error = e
        if attempt < DOWNLOAD_RETRIES:
            print(f"[gpger] 다운로드 실패 ({attempt}/{DOWNLOAD_RETRIES}), 재시도합니다: {last_error}")
    die(EXIT_NETWORK, f"{url} 다운로드에 {DOWNLOAD_RETRIES}번 실패했습니다: {last_error}")


def is_armored(data):
    return b"-----BEGIN PGP PUBLIC KEY BLOCK-----" in data[:200]


def dearmor(data):
    try:
        result = subprocess.run(["gpg", "--dearmor"], input=data, capture_output=True, check=True)
    except subprocess.CalledProcessError as e:
        die(EXIT_GPG, f"GPG 키 변환에 실패했습니다: {e.stderr.decode(errors='replace')}")
    return result.stdout


NAME_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")


def validate_name(name):
    if not NAME_RE.fullmatch(name) or name in {".", ".."} or "/" in name or "\\" in name:
        die(EXIT_USAGE, "--name은 영문 소문자/숫자/점/밑줄/하이픈만 사용할 수 있습니다 (경로 문자 금지).")
    return name


CONTROL_CHAR_RE = re.compile(r"[\r\n\x00]")


def validate_template_value(key, value):
    if CONTROL_CHAR_RE.search(value):
        die(EXIT_USAGE, f"{key} 값에 개행/제어 문자가 포함될 수 없습니다.")
    return value


def slugify(text):
    text = text.lower()
    text = re.sub(r"[^a-z0-9]+", "-", text)
    text = text.strip("-")
    # --name과 동일한 최대 길이(NAME_RE)를 적용 — 비정상적으로 긴 UID가
    # 파일시스템 이름 길이 제한을 넘겨 OSError를 내는 것을 방지한다.
    return text[:64].rstrip("-")


def extract_uid_slug(key_bytes):
    with tempfile.NamedTemporaryFile(suffix=".gpg") as tmp:
        tmp.write(key_bytes)
        tmp.flush()
        try:
            result = subprocess.run(
                ["gpg", "--with-colons", "--import-options", "show-only", "--import", tmp.name],
                capture_output=True,
                text=True,
                check=True,
            )
        except subprocess.CalledProcessError as e:
            die(EXIT_GPG, f"다운로드한 파일이 유효한 GPG 키가 아닙니다: {e.stderr}")
    for line in result.stdout.splitlines():
        if line.startswith("uid:"):
            fields = line.split(":")
            uid_str = fields[9] if len(fields) > 9 else ""
            name = re.split(r"[<(]", uid_str)[0].strip()
            if name:
                return slugify(name)
    return None


def confirm_overwrite(path):
    return confirm(f"[gpger] {path} 가 이미 존재합니다. 덮어쓸까요? [y/N] ")


def write_file_atomic(path, data, permission):
    tmp_path = path + ".tmp"
    mode, kwargs = ("wb", {}) if isinstance(data, bytes) else ("w", {"encoding": "utf-8"})
    with open(tmp_path, mode, **kwargs) as f:
        f.write(data)
    os.chmod(tmp_path, permission)
    os.replace(tmp_path, path)


def backup_if_exists(path):
    if not os.path.exists(path):
        return None
    backup_path = path + ".bak"
    shutil.copy2(path, backup_path)
    return backup_path


def restore_or_remove(path, backup_path):
    if backup_path:
        os.replace(backup_path, path)
    elif os.path.exists(path):
        os.remove(path)


def cleanup_backup(backup_path):
    if backup_path and os.path.exists(backup_path):
        os.remove(backup_path)


def cmd_config_get(key):
    # 값이 깨진 상태에서도 조회는 항상 가능해야 하므로 검증 없는 로드를 쓴다.
    cfg = load_config_raw()
    logger = setup_logging(cfg)
    logger.info(f"config get: {key or '(전체)'}")
    if not key:
        for k, v in flatten_config(cfg):
            print(f"{k} = {format_value(v)}")
        return
    value, found = get_nested(cfg, key)
    if not found:
        die(EXIT_CONFIG, f"'{key}' 키를 찾을 수 없습니다.")
    print(format_value(value))


def cmd_config_set(key, value):
    # 시작 상태가 깨져 있어도 set으로 고칠 수 있어야 하므로 검증 없는 로드로 시작한다.
    # 다만 실제로 저장하기 전에는, 바뀐 내용을 담은 candidate 전체가 검증을 통과해야 한다 —
    # 통과 못 하면 기존 설정 파일은 전혀 건드리지 않는다.
    cfg = load_config_raw()
    logger = setup_logging(cfg)
    candidate = copy.deepcopy(cfg)
    set_nested(candidate, key, value)
    errors = validate_config(candidate)
    if errors:
        die(
            EXIT_CONFIG,
            f"'{key}'에 그 값을 넣으면 설정이 유효하지 않아집니다:\n" + "\n".join(f"  - {e}" for e in errors),
        )
    save_config(candidate)
    logger.info(f"config set: {key} = {value}")
    print(f"[gpger] {key} = {value} 로 설정했습니다.")


def cmd_config_reset():
    ensure_config_dir()
    shutil.copy(DEFAULT_CONFIG_PATH, CONFIG_PATH)
    cfg = load_config()
    logger = setup_logging(cfg)
    logger.info("config reset")
    print(f"[gpger] 설정을 기본값으로 초기화했습니다: {CONFIG_PATH}")


APT_SOURCES_FILE = "/etc/apt/sources.list"
APT_SOURCES_DIR = "/etc/apt/sources.list.d"
APT_KEYRING_DIRS = ["/etc/apt/keyrings", "/usr/share/keyrings"]
APT_TRUSTED_DIR = "/etc/apt/trusted.gpg.d"


def find_apt_source_files():
    files = [APT_SOURCES_FILE] if os.path.isfile(APT_SOURCES_FILE) else []
    if os.path.isdir(APT_SOURCES_DIR):
        for name in sorted(os.listdir(APT_SOURCES_DIR)):
            if name.endswith(".list") or name.endswith(".sources"):
                files.append(os.path.join(APT_SOURCES_DIR, name))
    return files


def extract_signed_by(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            content = f.read()
    except OSError:
        return []
    if path.endswith(".sources"):
        return [
            m.group(1).strip()
            for m in re.finditer(r"(?im)^\s*signed-by\s*:\s*(/\S+)\s*$", content)
        ]
    return [m.group(1) for m in re.finditer(r"(?i)signed-by=([^\s\]]+)", content)]


def list_dir_files(path):
    if not os.path.isdir(path):
        return []
    return sorted(
        os.path.join(path, name)
        for name in os.listdir(path)
        if os.path.isfile(os.path.join(path, name))
    )


def is_ubuntu_keyring(path):
    return os.path.basename(path).lower().startswith("ubuntu-")


def colorize_purple(text):
    if sys.stdout.isatty():
        return f"\033[35m{text}\033[0m"
    return text


def format_entry(label, sources):
    if sources:
        return f"{label}  ({colorize_purple(', '.join(sources))})"
    return label


def print_section(title, entries):
    print(title)
    print("-" * len(title))
    if not entries:
        print("  (없음)")
    else:
        for entry in entries:
            print(f"  {entry}")
    print()


def cmd_config_ls():
    # 시스템 키링 스캔은 apt.* 값과 무관하므로 검증 없는 로드로 충분하다.
    cfg = load_config_raw()
    logger = setup_logging(cfg)
    logger.info("config ls")

    signed_by_map = {}
    for src in find_apt_source_files():
        for keyring_path in extract_signed_by(src):
            sources = signed_by_map.setdefault(keyring_path, [])
            if os.path.basename(src) not in sources:
                sources.append(os.path.basename(src))

    all_paths = set(signed_by_map)
    for d in APT_KEYRING_DIRS + [APT_TRUSTED_DIR]:
        all_paths.update(list_dir_files(d))

    etc_dir, usr_dir = APT_KEYRING_DIRS
    buckets = {"ubuntu": [], "etc": [], "usr": [], "other": [], "trusted": [], "orphan": []}

    for path in sorted(all_paths):
        sources = signed_by_map.get(path)
        if path.startswith(APT_TRUSTED_DIR + "/"):
            bucket, label = "trusted", os.path.basename(path)
        elif sources:
            if path.startswith(etc_dir + "/"):
                bucket, label = "etc", os.path.basename(path)
            elif path.startswith(usr_dir + "/"):
                bucket, label = "usr", os.path.basename(path)
            else:
                bucket, label = "other", path
        elif is_ubuntu_keyring(path):
            bucket, label = "ubuntu", os.path.basename(path)
        else:
            bucket, label = "orphan", os.path.basename(path)
        buckets[bucket].append(format_entry(label, sources))

    print_section("서명됨 (/etc/apt/keyrings/)", buckets["etc"])
    print_section("서명됨 (/usr/share/keyrings/)", buckets["usr"])
    print_section("서명됨 (기타 경로)", buckets["other"])
    print_section("신뢰됨 (/etc/apt/trusted.gpg.d, 레거시)", buckets["trusted"])
    print_section("Ubuntu OS 공개키", buckets["ubuntu"])
    print_section("참조 미검출 (signed-by 파싱 범위 밖일 수 있음)", buckets["orphan"])


def cmd_apt(args):
    if os.geteuid() != 0:
        die(EXIT_PERMISSION, "apt 등록에는 root 권한이 필요합니다. sudo로 실행해주세요.")

    cfg = load_config()
    logger = setup_logging(cfg)
    # load_config()가 이미 apt.* 값들의 존재/타입을 검증했으므로 여기서 다시 확인할 필요 없다.
    apt_cfg = cfg["apt"]
    arch = resolve_arch(cfg)

    arg_names = apt_cfg["args"]
    if len(args.extra_args) < len(arg_names):
        die(EXIT_USAGE, f"apt는 최소 {len(arg_names)}개의 인자({', '.join(arg_names)})가 필요합니다.")
    fixed_count = len(arg_names) - 1
    named_args = dict(zip(arg_names[:fixed_count], args.extra_args[:fixed_count]))
    named_args[arg_names[-1]] = " ".join(args.extra_args[fixed_count:])
    resolve_auto_values(named_args)
    for key, value in named_args.items():
        validate_template_value(key, value)
    validate_template_value("arch", arch)

    print(f"[gpger] {args.gpg_url} 다운로드 중...")
    data = download(args.gpg_url)
    if is_armored(data):
        data = dearmor(data)

    if args.name:
        name = validate_name(args.name)
    else:
        name = extract_uid_slug(data)
    if not name:
        die(EXIT_GPG, "키에서 이름을 추출하지 못했습니다. --name 으로 직접 지정해주세요.")

    gpg_dir = expand_path(apt_cfg["paths"]["gpg_dir"])
    source_dir = expand_path(apt_cfg["paths"]["source_dir"])
    ensure_dir(gpg_dir, "GPG 키 폴더")
    ensure_dir(source_dir, "apt 소스 폴더")

    gpg_path = os.path.join(gpg_dir, f"{name}.gpg")
    source_path = os.path.join(source_dir, f"{name}.sources")
    permission = int(str(apt_cfg["file"]["permission"]), 8)

    for path in (gpg_path, source_path):
        if os.path.exists(path) and not confirm_overwrite(path):
            print("[gpger] 취소했습니다.")
            logger.info(f"사용자 취소: {path}")
            return

    # 덮어쓰는 경우를 대비해 기존 파일을 백업해두고, 아래 블록에서 무엇이 실패하든
    # (apt update 실패든, 그 사이의 파이썬 예외든) 이전 상태로 되돌린다.
    gpg_backup = backup_if_exists(gpg_path)
    source_backup = backup_if_exists(source_path)

    try:
        source_content = apt_cfg["source_template"].format(arch=arch, gpg_path=gpg_path, **named_args)
        write_file_atomic(gpg_path, data, permission)
        write_file_atomic(source_path, source_content.rstrip("\n") + "\n", permission)

        logger.info(f"등록 완료: name={name} gpg={gpg_path} source={source_path}")
        print(f"[gpger] 완료: {gpg_path}")
        print(f"[gpger] 완료: {source_path}")

        print("[gpger] apt update 실행 중...")
        result = subprocess.run(["apt-get", "update"])
        if result.returncode != 0:
            raise AptUpdateFailed(result.returncode)
    except AptUpdateFailed as e:
        restore_or_remove(gpg_path, gpg_backup)
        restore_or_remove(source_path, source_backup)
        logger.info(f"apt update 실패: name={name} returncode={e.returncode}, 이전 상태로 복원")
        die(
            EXIT_APT_UPDATE,
            f"apt update가 실패해서 등록을 취소하고 이전 상태로 복원했습니다 (종료 코드 {e.returncode}).",
        )
    except KeyboardInterrupt:
        restore_or_remove(gpg_path, gpg_backup)
        restore_or_remove(source_path, source_backup)
        logger.info(f"등록 중 사용자가 중단(Ctrl+C)함, 이전 상태로 복원: name={name}")
        raise
    except Exception as e:
        restore_or_remove(gpg_path, gpg_backup)
        restore_or_remove(source_path, source_backup)
        logger.info(f"등록 중 예외 발생, 이전 상태로 복원: name={name} error={e!r}")
        die(EXIT_FILESYSTEM, f"등록 중 오류가 발생해서 취소하고 이전 상태로 복원했습니다: {e}")

    cleanup_backup(gpg_backup)
    cleanup_backup(source_backup)
    logger.info(f"apt update 성공: name={name}")
    print("[gpger] apt update 완료.")


def main():
    global AUTO_YES

    parser = argparse.ArgumentParser(prog="gpger", description="GPG 키 자동 등록 도구")
    parser.add_argument(
        "-y", "--yes", action="store_true", help="확인 프롬프트에 항상 예로 응답 (비대화형 환경용, 서브커맨드 앞에 지정)"
    )
    sub = parser.add_subparsers(dest="command", required=True)

    config_parser = sub.add_parser("config", help="설정 값을 조회/변경합니다")
    config_sub = config_parser.add_subparsers(dest="config_command", required=True)

    get_parser = config_sub.add_parser("get", help="설정 값을 조회합니다 (키 생략 시 전체 출력)")
    get_parser.add_argument("key", nargs="?")

    set_parser = config_sub.add_parser("set", help="설정 값을 변경합니다")
    set_parser.add_argument("key")
    set_parser.add_argument("value")

    config_sub.add_parser("reset", help="설정을 기본값으로 초기화합니다")
    config_sub.add_parser("ls", help="시스템에 등록된 apt 키링을 조회합니다")

    apt_parser = sub.add_parser("apt", help="GPG 키를 받아 apt 소스로 등록합니다")
    apt_parser.add_argument("gpg_url")
    apt_parser.add_argument("extra_args", nargs="*", help="config의 apt.args 순서대로 (예: repo suite component)")
    apt_parser.add_argument("--name", "-n", help="파일명을 직접 지정 (미지정 시 키 UID에서 자동 추출)")

    args = parser.parse_args()
    AUTO_YES = args.yes

    if args.command == "config":
        if args.config_command == "get":
            cmd_config_get(args.key)
        elif args.config_command == "set":
            cmd_config_set(args.key, args.value)
        elif args.config_command == "reset":
            cmd_config_reset()
        elif args.config_command == "ls":
            cmd_config_ls()
    elif args.command == "apt":
        cmd_apt(args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        # head/less 등으로 파이프가 먼저 끊긴 경우 — 정상적인 조기 종료이므로 조용히 처리한다.
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(1)
